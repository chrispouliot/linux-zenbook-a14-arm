Subject: [EXPERIMENT] drm/msm/dp: A14 DSC receiver teardown and checked wake setup

Apply after the tested 4K60 and 144 Hz DSC patches. Default-off module gate;
UX3407NA af54000 controller only. Clear sink DSC/FEC using AUX rather than
native HPD, wake receiver before enabling DSC, verify link configuration,
and balance failed-enable resources. Does not claim to repair DPU commit
timeouts if the physical link still fails. Existing mode budgets retained.

--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -10,6 +10,8 @@
 #include <linux/completion.h>
 #include <linux/delay.h>
 #include <linux/iopoll.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
 #include <linux/phy/phy.h>
 #include <linux/phy/phy-dp.h>
 #include <linux/pm_opp.h>
@@ -27,6 +29,11 @@
 #include "dp_tu_calc.h"
 #include <drm/drm_fixed.h>
 
+static bool a14_dp_dsc_wake_test;
+module_param(a14_dp_dsc_wake_test, bool, 0444);
+MODULE_PARM_DESC(a14_dp_dsc_wake_test,
+	"Test A14 port-one DSC teardown and checked receiver setup on wake");
+
 #define POLLING_SLEEP_US			1000
 #define POLLING_TIMEOUT_US			10000
 
@@ -122,6 +129,49 @@
 	bool dsc_configured;
 };
 
+bool msm_dp_ctrl_a14_wake_enabled(struct msm_dp_ctrl *msm_dp_ctrl)
+{
+	struct msm_dp_ctrl_private *ctrl = container_of(msm_dp_ctrl,
+		struct msm_dp_ctrl_private, msm_dp_ctrl);
+
+	return a14_dp_dsc_wake_test &&
+		of_machine_is_compatible("asus,zenbook-a14-ux3407na") &&
+		of_device_is_compatible(ctrl->dev->of_node, "qcom,glymur-dp") &&
+		!strcmp(dev_name(ctrl->dev), "af54000.displayport-controller");
+}
+
+/*
+ * AUX access is also valid with Type-C HPD delivered by PMIC GLINK.
+ * The existing AUX transfer gate still rejects accesses after disconnect;
+ * this experiment never overrides enable_xfers or the AUX runtime-PM guard.
+ */
+static int msm_dp_ctrl_a14_write_verify(struct msm_dp_ctrl_private *ctrl,
+				      unsigned int address, u8 value)
+{
+	u8 actual;
+	int ret;
+
+	ret = drm_dp_dpcd_writeb(ctrl->aux, address, value);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	ret = drm_dp_dpcd_readb(ctrl->aux, address, &actual);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	return actual == value ? 0 : -EIO;
+}
+
+static int msm_dp_ctrl_a14_clear_sink(struct msm_dp_ctrl_private *ctrl)
+{
+	int dsc, fec;
+
+	/* Attempt both clears; host shutdown must proceed even after AUX failure. */
+	dsc = msm_dp_ctrl_a14_write_verify(ctrl, DP_DSC_ENABLE, 0);
+	fec = msm_dp_ctrl_a14_write_verify(ctrl, DP_FEC_CONFIGURATION, 0);
+	dev_info(ctrl->dev, "A14-DSC-wake: sink clear DSC=%d FEC=%d native_hpd=%u\n",
+		 dsc, fec, msm_dp_aux_is_link_connected(ctrl->aux));
+	return dsc ? dsc : fec;
+}
+
 static inline u32 msm_dp_read_ahb(const struct msm_dp_ctrl_private *ctrl, u32 offset)
 {
 	return readl_relaxed(ctrl->ahb_base + offset);
@@ -179,6 +229,43 @@
 	return err;
 }
 
+static int msm_dp_ctrl_a14_link_configure(struct msm_dp_ctrl_private *ctrl,
+					 struct msm_dp_link_info *link)
+{
+	u8 actual[2];
+	u8 lanes = link->num_lanes | DP_LANE_COUNT_ENHANCED_FRAME_EN;
+	u8 rate = drm_dp_link_rate_to_bw_code(link->rate);
+	int attempt, ret = -EIO;
+
+	/* This experiment uses LINK_BW_SET, never the eDP rate table. */
+	if (link->use_rate_set)
+		return -EINVAL;
+	for (attempt = 0; attempt < 2; attempt++) {
+		ret = drm_dp_dpcd_writeb(ctrl->aux, DP_LANE_COUNT_SET, lanes);
+		if (ret == 1)
+			ret = drm_dp_dpcd_writeb(ctrl->aux, DP_LINK_BW_SET, rate);
+		if (ret == 1) {
+			ret = drm_dp_dpcd_read(ctrl->aux, DP_LINK_BW_SET,
+					       actual, sizeof(actual));
+			if (ret == sizeof(actual) && actual[0] == rate &&
+			    actual[1] == lanes) {
+				dev_info(ctrl->dev,
+					 "A14-DSC-wake: receiver verified rate=%02x lanes=%02x attempt=%d\n",
+					 rate, lanes, attempt + 1);
+				return 0;
+			}
+		}
+		if (ret >= 0)
+			ret = -EIO;
+		dev_warn(ctrl->dev,
+			 "A14-DSC-wake: receiver setup attempt=%d failed=%d\n",
+			 attempt + 1, ret);
+		if (!attempt)
+			msleep(20);
+	}
+	return ret;
+}
+
 /*
  * NOTE: resetting DP controller will also clear any pending HPD related interrupts
  */
@@ -1710,13 +1797,22 @@
 	link_info.rate = ctrl->link->link_params.rate;
 	link_info.capabilities = DP_LINK_CAP_ENHANCED_FRAMING;
 
-	msm_dp_aux_link_configure(ctrl->aux, &link_info);
+	if (msm_dp_ctrl_a14_wake_enabled(&ctrl->msm_dp_ctrl)) {
+		ret = msm_dp_ctrl_a14_link_configure(ctrl, &link_info);
+		if (ret)
+			return ret;
+	} else {
+		msm_dp_aux_link_configure(ctrl->aux, &link_info);
+	}
 
 	if (drm_dp_max_downspread(dpcd))
 		encoding[0] |= DP_SPREAD_AMP_0_5;
 
 	/* config DOWNSPREAD_CTRL and MAIN_LINK_CHANNEL_CODING_SET */
-	drm_dp_dpcd_write(ctrl->aux, DP_DOWNSPREAD_CTRL, encoding, 2);
+	ret = drm_dp_dpcd_write(ctrl->aux, DP_DOWNSPREAD_CTRL, encoding, 2);
+	if (msm_dp_ctrl_a14_wake_enabled(&ctrl->msm_dp_ctrl) && ret != 2)
+		return ret < 0 ? ret : -EIO;
+	ret = 0;
 
 	if (drm_dp_alternate_scrambler_reset_cap(dpcd)) {
 		assr = DP_ALTERNATE_SCRAMBLER_RESET_ENABLE;
@@ -1802,7 +1898,9 @@
 {
 	if (!ctrl->dsc_configured)
 		return;
-	if (msm_dp_aux_is_link_connected(ctrl->aux)) {
+	if (msm_dp_ctrl_a14_wake_enabled(&ctrl->msm_dp_ctrl)) {
+		msm_dp_ctrl_a14_clear_sink(ctrl);
+	} else if (msm_dp_aux_is_link_connected(ctrl->aux)) {
 		drm_dp_dpcd_writeb(ctrl->aux, DP_DSC_ENABLE, 0);
 		drm_dp_dpcd_writeb(ctrl->aux, DP_FEC_CONFIGURATION, 0);
 	}
@@ -1813,6 +1911,28 @@
 	ctrl->dsc_configured = false;
 }
 
+static int msm_dp_ctrl_a14_prepare_sink(struct msm_dp_ctrl_private *ctrl)
+{
+	u8 power;
+	int ret;
+
+	/* Check the D0 write too: the older power-up helper ignores write failure. */
+	ret = drm_dp_dpcd_readb(ctrl->aux, DP_SET_POWER, &power);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	power = (power & ~DP_SET_POWER_MASK) | DP_SET_POWER_D0;
+	ret = drm_dp_dpcd_writeb(ctrl->aux, DP_SET_POWER, power);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	usleep_range(1000, 2000);
+	ret = drm_dp_dpcd_readb(ctrl->aux, DP_SET_POWER, &power);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	if ((power & DP_SET_POWER_MASK) != DP_SET_POWER_D0)
+		return -EIO;
+	return msm_dp_ctrl_a14_clear_sink(ctrl);
+}
+
 static int msm_dp_ctrl_setup_main_link(struct msm_dp_ctrl_private *ctrl,
 			int *training_step)
 {
@@ -2472,12 +2592,25 @@
 	if (rc)
 		return rc;
 
+	if (msm_dp_ctrl_a14_wake_enabled(msm_dp_ctrl) &&
+	    DP_DSC_PANEL_EN(ctrl->panel) && !ctrl->stream_clks_on) {
+		rc = msm_dp_ctrl_a14_prepare_sink(ctrl);
+		if (rc) {
+			dev_err(ctrl->dev, "A14-DSC-wake: prepare sink failed=%d\n", rc);
+			goto training_done;
+		}
+	}
+
 	while (--link_train_max_retries) {
 		training_step = DP_TRAINING_NONE;
 		rc = msm_dp_ctrl_setup_main_link(ctrl, &training_step);
 		if (rc == 0) {
 			/* training completed successfully */
 			break;
+		} else if (msm_dp_ctrl_a14_wake_enabled(msm_dp_ctrl) &&
+			   training_step == DP_TRAINING_NONE) {
+			/* Checked AUX setup already made its bounded retry. */
+			break;
 		} else if (training_step == DP_TRAINING_1) {
 			/* link train_1 failed */
 			if (!msm_dp_aux_is_link_connected(ctrl->aux))
@@ -2532,6 +2665,7 @@
 		}
 	}
 
+training_done:
 	if (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN)
 		return rc;
 
