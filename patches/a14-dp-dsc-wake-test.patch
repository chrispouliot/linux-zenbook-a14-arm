+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1559,6 +1559,15 @@
 	rc = msm_dp_ctrl_on_link(msm_dp_display->ctrl);
 	if (rc) {
 		DRM_ERROR("Failed link training (rc=%d)\n", rc);
+		if (msm_dp_ctrl_a14_wake_enabled(msm_dp_display->ctrl)) {
+			/* on_link has shut down its failed training attempt. */
+			if (aux_initialized_here)
+				msm_dp_display_host_phy_exit(msm_dp_display);
+			msm_dp_display->a14_enable_aborted = true;
+			pm_runtime_put_sync(&dp->pdev->dev);
+			dev_warn(&dp->pdev->dev,
+				 "A14-DSC-wake: failed enable resources released\n");
+		}
 		// TODO: schedule drm_connector_set_link_status_property()
 		return;
 	}
