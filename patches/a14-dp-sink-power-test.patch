+int msm_dp_ctrl_a14_sink_power(struct msm_dp_ctrl *msm_dp_ctrl, bool on)
+{
+	struct msm_dp_ctrl_private *ctrl = container_of(msm_dp_ctrl,
+		struct msm_dp_ctrl_private, msm_dp_ctrl);
+	u8 power, requested;
+	int ret;
+
+	if (!a14_dp_sink_power_test ||
+	    !msm_dp_ctrl_a14_wake_enabled(msm_dp_ctrl))
+		return 0;
+	if (ctrl->panel->dpcd[DP_DPCD_REV] < 0x11 ||
+	    ctrl->panel->dpcd[DP_DPCD_REV] == 0xff ||
+	    ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN)
+		return 0;
+
+	/* Called while AUX is initialized; never bypass its disconnect guard. */
+	if (!on)
+		msm_dp_ctrl_dsc_stop(ctrl);
+
+	ret = drm_dp_dpcd_readb(ctrl->aux, DP_SET_POWER, &power);
+	if (ret != 1)
+		goto fail;
+	requested = (power & ~DP_SET_POWER_MASK) |
+		(on ? DP_SET_POWER_D0 : DP_SET_POWER_D3);
+	ret = drm_dp_dpcd_writeb(ctrl->aux, DP_SET_POWER, requested);
+	if (ret != 1)
+		goto fail;
+
+	if (on) {
+		usleep_range(1000, 2000);
+		ret = drm_dp_dpcd_readb(ctrl->aux, DP_SET_POWER, &power);
+		if (ret != 1)
+			goto fail;
+		if ((power & DP_SET_POWER_MASK) != DP_SET_POWER_D0) {
+			ret = -EIO;
+			goto fail;
+		}
+		dev_info(ctrl->dev, "A14-DP-power: D0 verified before sink check\n");
+	} else {
+		/* No read after D3: the receiver is allowed to go to sleep. */
+		dev_info(ctrl->dev, "A14-DP-power: D3 write accepted before PHY shutdown\n");
+	}
+	return 0;
+fail:
+	if (ret >= 0)
+		ret = -EIO;
+	dev_warn(ctrl->dev, "A14-DP-power: D%u request failed=%d\n",
+		 on ? 0 : 3, ret);
+	return ret;
+}
