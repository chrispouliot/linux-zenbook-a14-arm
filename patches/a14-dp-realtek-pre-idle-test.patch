+static void msm_dp_ctrl_a14_realtek_hold(struct msm_dp_ctrl *msm_dp_ctrl,
+				       bool before_idle)
 {
 	static const u8 realtek_id[] = {
 		0x00, 0xe0, 0x4c, 'D', 'p', '1', '.', '4', 0x00
 	};
 	struct msm_dp_ctrl_private *ctrl = container_of(msm_dp_ctrl,
 		struct msm_dp_ctrl_private, msm_dp_ctrl);
-	unsigned int hold_ms = READ_ONCE(a14_dp_realtek_idle_hold_ms);
+	unsigned int hold_ms = before_idle ?
+		READ_ONCE(a14_dp_realtek_pre_idle_hold_ms) :
+		READ_ONCE(a14_dp_realtek_idle_hold_ms);
+	const char *tag = before_idle ? "A14-Realtek-pre-idle" : "A14-Realtek-idle";
 	u8 identity[sizeof(realtek_id)];
 	int ret;
 
@@ -858,10 +868,11 @@
 		return;
 	if (!msm_dp_ctrl_a14_wake_enabled(msm_dp_ctrl)) {
 		dev_info(ctrl->dev,
-			 "A14-Realtek-idle: SKIP outside enabled A14 port-one wake path\n");
+			 "%s: SKIP outside enabled A14 port-one wake path\n", tag);
 		return;
 	}
-	if (!ctrl->a14_idle_completed || !ctrl->dsc_configured ||
+	if ((before_idle ? ctrl->a14_idle_completed : !ctrl->a14_idle_completed) ||
+	    !ctrl->dsc_configured ||
 	    !ctrl->core_clks_on || !ctrl->stream_clks_on ||
 	    !ctrl->link_clks_on || ctrl->a14_early_d3_status ||
 	    !drm_dp_is_branch(ctrl->panel->dpcd) ||
@@ -869,8 +880,8 @@
 	    ctrl->link->link_params.num_lanes != 2 ||
 	    (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN)) {
 		dev_info(ctrl->dev,
-			 "A14-Realtek-idle: SKIP idle=%d dsc=%d clocks=%d/%d/%d early_d3=%d branch=%d rate=%u lanes=%u phy_test=%d\n",
-			 ctrl->a14_idle_completed, ctrl->dsc_configured,
+			 "%s: SKIP idle=%d dsc=%d clocks=%d/%d/%d early_d3=%d branch=%d rate=%u lanes=%u phy_test=%d\n",
+			 tag, ctrl->a14_idle_completed, ctrl->dsc_configured,
 			 ctrl->core_clks_on, ctrl->link_clks_on, ctrl->stream_clks_on,
 			 ctrl->a14_early_d3_status,
 			 !!drm_dp_is_branch(ctrl->panel->dpcd),
@@ -888,7 +899,7 @@
 	if (a14_dp_defer_sink_clear_test || a14_dp_d3_before_dsc_test ||
 	    a14_dp_early_d3_test) {
 		dev_warn(ctrl->dev,
-			 "A14-Realtek-idle: disable the three shutdown experiments first; no hold\n");
+			 "%s: disable the three shutdown experiments first; no hold\n", tag);
 		return;
 	}
 
@@ -896,23 +907,41 @@
 			     sizeof(identity));
 	if (ret != (int)sizeof(identity)) {
 		dev_warn(ctrl->dev,
-			 "A14-Realtek-idle: branch identity read returned %d; no hold\n",
-			 ret);
+			 "%s: branch identity read returned %d; no hold\n",
+			 tag, ret);
 		return;
 	}
 	if (memcmp(identity, realtek_id, sizeof(realtek_id))) {
 		dev_info(ctrl->dev,
-			 "A14-Realtek-idle: branch identity does not match; no hold\n");
+			 "%s: branch identity does not match; no hold\n", tag);
 		return;
 	}
 
 	hold_ms = min(hold_ms, 1000U);
-	dev_info(ctrl->dev,
-		 "A14-Realtek-idle: BEGIN %u ms hold after PUSH_IDLE; DPU/DSC/FEC teardown has not started\n",
-		 hold_ms);
+	if (before_idle)
+		dev_info(ctrl->dev,
+			 "%s: BEGIN %u ms hold before PUSH_IDLE; stream-stop request has not been sent\n",
+			 tag, hold_ms);
+	else
+		dev_info(ctrl->dev,
+			 "%s: BEGIN %u ms hold after PUSH_IDLE; DPU/DSC/FEC teardown has not started\n",
+			 tag, hold_ms);
 	msleep(hold_ms);
-	dev_info(ctrl->dev,
-		 "A14-Realtek-idle: END hold; normal DPU/DSC/FEC/power shutdown follows\n");
+	if (before_idle)
+		dev_info(ctrl->dev, "%s: END hold; PUSH_IDLE follows\n", tag);
+	else
+		dev_info(ctrl->dev,
+			 "%s: END hold; normal DPU/DSC/FEC/power shutdown follows\n", tag);
+}
+
+void msm_dp_ctrl_a14_realtek_pre_idle_hold(struct msm_dp_ctrl *msm_dp_ctrl)
+{
+	msm_dp_ctrl_a14_realtek_hold(msm_dp_ctrl, true);
+}
+
+void msm_dp_ctrl_a14_realtek_idle_hold(struct msm_dp_ctrl *msm_dp_ctrl)
+{
+	msm_dp_ctrl_a14_realtek_hold(msm_dp_ctrl, false);
 }
 
