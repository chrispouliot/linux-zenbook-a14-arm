diff --git a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
index 6c5f56c2e..70be58adf 100644
--- a/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
+++ b/drivers/phy/qualcomm/phy-qcom-qmp-combo.c
@@ -3757,6 +3757,12 @@ static int qmp_combo_com_init(struct qmp_combo *qmp, bool force)
 	int ret;
 	u32 val;
 
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: com_init enter force=%d init=%d usb_init=%u dp_init=%u qmp_mode=%d phy_mode=%d orientation=%d\n",
+		 force, qmp->init_count, qmp->usb_init_count,
+		 qmp->dp_init_count, qmp->qmpphy_mode, qmp->phy_mode,
+		 qmp->orientation);
+
 	if (!force && qmp->init_count++)
 		return 0;
 
@@ -3845,6 +3851,13 @@ static int qmp_combo_com_init(struct qmp_combo *qmp, bool force)
 	qphy_setbits(qmp->pcs, cfg->regs[QPHY_PCS_POWER_DOWN_CONTROL],
 			SW_PWRDN);
 
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: com_init programmed init=%d qmp_mode=%d orientation=%d typec=%#x mode_ctrl=%#x reset=%#x\n",
+		 qmp->init_count, qmp->qmpphy_mode, qmp->orientation,
+		 readl(com + QPHY_V3_DP_COM_TYPEC_CTRL),
+		 readl(com + QPHY_V3_DP_COM_PHY_MODE_CTRL),
+		 readl(com + QPHY_V3_DP_COM_RESET_OVRD_CTRL));
+
 	return 0;
 
 err_disable_clocks:
@@ -3884,6 +3897,11 @@ static int qmp_combo_dp_init(struct phy *phy)
 
 	mutex_lock(&qmp->phy_mutex);
 
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: dp_init enter init=%d usb_init=%u dp_init=%u qmp_mode=%d phy_mode=%d orientation=%d\n",
+		 qmp->init_count, qmp->usb_init_count, qmp->dp_init_count,
+		 qmp->qmpphy_mode, qmp->phy_mode, qmp->orientation);
+
 	ret = qmp_combo_com_init(qmp, false);
 	if (ret)
 		goto out_unlock;
@@ -3891,6 +3909,14 @@ static int qmp_combo_dp_init(struct phy *phy)
 	cfg->dp_aux_init(qmp);
 
 	qmp->dp_init_count++;
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: dp_init ready init=%d usb_init=%u dp_init=%u qmp_mode=%d orientation=%d typec=%#x mode_ctrl=%#x aux2=%#x pd=%#x\n",
+		 qmp->init_count, qmp->usb_init_count, qmp->dp_init_count,
+		 qmp->qmpphy_mode, qmp->orientation,
+		 readl(qmp->com + QPHY_V3_DP_COM_TYPEC_CTRL),
+		 readl(qmp->com + QPHY_V3_DP_COM_PHY_MODE_CTRL),
+		 readl(qmp->dp_dp_phy + QSERDES_DP_PHY_AUX_CFG2),
+		 readl(qmp->dp_dp_phy + QSERDES_DP_PHY_PD_CTL));
 
 out_unlock:
 	mutex_unlock(&qmp->phy_mutex);
@@ -4037,6 +4063,11 @@ static int qmp_combo_usb_init(struct phy *phy)
 	int ret;
 
 	mutex_lock(&qmp->phy_mutex);
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: usb_init enter init=%d usb_init=%u dp_init=%u qmp_mode=%d phy_mode=%d orientation=%d\n",
+		 qmp->init_count, qmp->usb_init_count, qmp->dp_init_count,
+		 qmp->qmpphy_mode, qmp->phy_mode, qmp->orientation);
+
 	ret = qmp_combo_com_init(qmp, false);
 	if (ret)
 		goto out_unlock;
@@ -4048,6 +4079,13 @@ static int qmp_combo_usb_init(struct phy *phy)
 	}
 
 	qmp->usb_init_count++;
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: usb_init ready init=%d usb_init=%u dp_init=%u qmp_mode=%d orientation=%d typec=%#x mode_ctrl=%#x reset=%#x\n",
+		 qmp->init_count, qmp->usb_init_count, qmp->dp_init_count,
+		 qmp->qmpphy_mode, qmp->orientation,
+		 readl(qmp->com + QPHY_V3_DP_COM_TYPEC_CTRL),
+		 readl(qmp->com + QPHY_V3_DP_COM_PHY_MODE_CTRL),
+		 readl(qmp->com + QPHY_V3_DP_COM_RESET_OVRD_CTRL));
 
 out_unlock:
 	mutex_unlock(&qmp->phy_mutex);
@@ -4079,6 +4117,12 @@ static int qmp_combo_usb_set_mode(struct phy *phy, enum phy_mode mode, int submo
 {
 	struct qmp_combo *qmp = phy_get_drvdata(phy);
 
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: usb_set_mode old=%d new=%d submode=%d init=%d usb_init=%u dp_init=%u qmp_mode=%d orientation=%d\n",
+		 qmp->phy_mode, mode, submode, qmp->init_count,
+		 qmp->usb_init_count, qmp->dp_init_count, qmp->qmpphy_mode,
+		 qmp->orientation);
+
 	qmp->phy_mode = mode;
 
 	return 0;
@@ -4520,6 +4564,12 @@ static int qmp_combo_typec_switch_set(struct typec_switch_dev *sw,
 	struct qmp_combo *qmp = typec_switch_get_drvdata(sw);
 	const struct qmp_phy_cfg *cfg = qmp->cfg;
 
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: typec_switch old_orientation=%d new_orientation=%d init=%d usb_init=%u dp_init=%u qmp_mode=%d powered=%d\n",
+		 qmp->orientation, orientation, qmp->init_count,
+		 qmp->usb_init_count, qmp->dp_init_count, qmp->qmpphy_mode,
+		 qmp->dp_powered_on);
+
 	if (orientation == qmp->orientation || orientation == TYPEC_ORIENTATION_NONE)
 		return 0;
 
@@ -4578,6 +4628,12 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 		new_mode = QMPPHY_MODE_USB3_ONLY;
 	}
 
+	dev_info(qmp->dev,
+		 "A14-DP-ORDER: typec_mux request state_mode=%lu svid=%#x old_qmp_mode=%d new_qmp_mode=%d init=%d usb_init=%u dp_init=%u powered=%d orientation=%d\n",
+		 state->mode, svid, qmp->qmpphy_mode, new_mode,
+		 qmp->init_count, qmp->usb_init_count, qmp->dp_init_count,
+		 qmp->dp_powered_on, qmp->orientation);
+
 	if (new_mode == qmp->qmpphy_mode) {
 		dev_dbg(qmp->dev, "typec_mux_set: same qmpphy mode, bail out\n");
 		return 0;
@@ -4620,6 +4676,19 @@ static int qmp_combo_typec_mux_set(struct typec_mux_dev *mux, struct typec_mux_s
 			if (qmp->dp_init_count)
 				cfg->dp_aux_init(qmp);
 		}
+
+		dev_info(qmp->dev,
+			 "A14-DP-ORDER: typec_mux applied qmp_mode=%d init=%d usb_init=%u dp_init=%u orientation=%d typec=%#x mode_ctrl=%#x reset=%#x\n",
+			 qmp->qmpphy_mode, qmp->init_count,
+			 qmp->usb_init_count, qmp->dp_init_count,
+			 qmp->orientation,
+			 readl(qmp->com + QPHY_V3_DP_COM_TYPEC_CTRL),
+			 readl(qmp->com + QPHY_V3_DP_COM_PHY_MODE_CTRL),
+			 readl(qmp->com + QPHY_V3_DP_COM_RESET_OVRD_CTRL));
+	} else {
+		dev_info(qmp->dev,
+			 "A14-DP-ORDER: typec_mux cached while inactive qmp_mode=%d orientation=%d\n",
+			 qmp->qmpphy_mode, qmp->orientation);
 	}
 
 	return 0;
