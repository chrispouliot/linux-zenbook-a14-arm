+/* Caller selects this only for the gated native two-lane eDP mode. */
+static int msm_dp_ctrl_a14_edp_train(struct msm_dp_ctrl_private *ctrl,
+				     bool reinitialize)
+{
+	unsigned int training_step;
+	int attempt, ret;
+
+	/* Never restart a video stream on the invalid one-lane fallback. */
+	if (!msm_dp_ctrl_a14_edp_link_fits(ctrl))
+		return -ENOSPC;
+
+	for (attempt = 1; attempt <= 3; attempt++) {
+		ctrl->link->phy_params.v_level = 0;
+		ctrl->link->phy_params.p_level = 0;
+		training_step = DP_TRAINING_NONE;
+		ret = msm_dp_ctrl_setup_main_link(ctrl, &training_step);
+		dev_info(ctrl->dev,
+			 "A14-eDP-retry: attempt=%d rate=%u lanes=%u step=%u rc=%d\n",
+			 attempt, ctrl->link->link_params.rate,
+			 ctrl->link->link_params.num_lanes, training_step, ret);
+		if (!ret)
+			return 0;
+
+		msm_dp_ctrl_clear_training_pattern(ctrl, DP_PHY_DPRX);
+		if (attempt == 3 || training_step == DP_TRAINING_NONE ||
+		    !msm_dp_aux_is_link_connected(ctrl->aux))
+			return ret;
+
+		/* Retain the rate/lane count; neither fallback fits this mode. */
+		if (reinitialize) {
+			ret = msm_dp_ctrl_reinitialize_mainlink(ctrl);
+			if (ret)
+				return ret;
+		} else {
+			/* Pixel clocks may be live during retrain/maintenance. */
+			msleep(20);
+		}
+	}
+
+	return -ETIMEDOUT;
+}
