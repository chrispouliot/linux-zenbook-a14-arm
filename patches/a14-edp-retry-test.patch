+static bool msm_dp_ctrl_a14_edp_native(struct msm_dp_ctrl_private *ctrl)
+{
+	const struct drm_display_mode *mode = &ctrl->panel->msm_dp_mode.drm_mode;
+
+	/* Keep this experiment on the captured uncompressed native panel mode. */
+	return msm_dp_ctrl_a14_edp_retry_enabled(&ctrl->msm_dp_ctrl) &&
+		!(ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN) &&
+		!DP_DSC_PANEL_EN(ctrl->panel) &&
+		!ctrl->panel->msm_dp_mode.out_fmt_is_yuv_420 &&
+		ctrl->panel->msm_dp_mode.bpp == 24 &&
+		mode->hdisplay == 1920 && mode->vdisplay == 1200 &&
+		mode->clock == 154260 &&
+		ctrl->panel->link_info.rate == 270000 &&
+		ctrl->panel->link_info.num_lanes == 2;
+}
+
+static bool msm_dp_ctrl_a14_edp_link_fits(struct msm_dp_ctrl_private *ctrl)
+{
+	/* Full mode clock: wide-bus halves the interface clock, not payload. */
+	u64 required = (u64)ctrl->panel->msm_dp_mode.drm_mode.clock *
+		ctrl->panel->msm_dp_mode.bpp;
+	u64 available = (u64)ctrl->link->link_params.rate *
+		ctrl->link->link_params.num_lanes * 8;
+
+	return required && required <= available;
 }
 
