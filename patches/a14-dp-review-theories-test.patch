+static int msm_dp_ctrl_a14_teardown_sink(struct msm_dp_ctrl_private *ctrl)
+{
+	static const unsigned int addresses[] = { DP_DSC_ENABLE, DP_FEC_CONFIGURATION };
+	u8 value, reply;
+	int i, ret;
+
+	if (!a14_dp_bounded_cleanup_test ||
+	    !msm_dp_ctrl_a14_wake_enabled(&ctrl->msm_dp_ctrl) ||
+	    (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN))
+		return msm_dp_ctrl_a14_clear_sink(ctrl);
+
+	for (i = 0; i < ARRAY_SIZE(addresses); i++) {
+		value = 0;
+		ret = msm_dp_ctrl_a14_single_xfer(ctrl->aux, addresses[i],
+				DP_AUX_NATIVE_WRITE, &value, 1, &reply);
+		if (ret != 1)
+			goto failed;
+		ret = msm_dp_ctrl_a14_single_xfer(ctrl->aux, addresses[i],
+				DP_AUX_NATIVE_READ, &value, 1, &reply);
+		if (ret != 1)
+			goto failed;
+		if (value) {
+			ret = -EIO;
+			goto failed;
+		}
+	}
+	dev_info(ctrl->dev, "A14-bounded-cleanup: DSC/FEC cleared and verified\n");
+	return 0;
+failed:
+	ret = ret < 0 ? ret : -EIO;
+	dev_info(ctrl->dev,
+		 "A14-bounded-cleanup: stop address=%#x ret=%d reply=%#x; host teardown continues\n",
+		 addresses[i], ret, reply);
 	return ret;
 }
 
