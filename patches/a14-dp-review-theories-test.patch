+/*
+ * eDP mode_set runs before the powered panel capability read. Do not reuse
+ * its bandwidth-reduced depth: retain the original requested depth and
+ * recompute after successful HPD setup, before on_link/on_stream consume it.
+ * This is uncompressed eDP only; no early panel power or invented caps.
+ */
+static int msm_dp_a14_edp_finalize_bpp(struct msm_dp_display_private *dp)
+{
+	struct msm_dp_panel *panel = dp->panel;
+	u32 before = dp->msm_dp_mode->bpp;
+	u64 capacity, required;
+	int ret;
+
+	if (!panel->link_info.rate || !panel->link_info.num_lanes ||
+	    !dp->a14_requested_bpp || panel->dsc_en ||
+	    dp->msm_dp_mode->out_fmt_is_yuv_420)
+		return -EINVAL;
+
+	dp->msm_dp_mode->bpp = dp->a14_requested_bpp;
+	ret = msm_dp_panel_init_panel_info(panel);
+	if (ret)
+		return ret;
+
+	capacity = (u64)panel->link_info.rate * panel->link_info.num_lanes * 8;
+	required = (u64)dp->msm_dp_mode->drm_mode.clock * dp->msm_dp_mode->bpp;
+	dev_info(&dp->msm_dp_display.pdev->dev,
+		 "A14-eDP-bpp: requested=%u before=%u selected=%u rate=%u lanes=%u fits=%u\n",
+		 dp->a14_requested_bpp, before, dp->msm_dp_mode->bpp,
+		 panel->link_info.rate, panel->link_info.num_lanes,
+		 (unsigned int)(required && required <= capacity));
+	return required && required <= capacity ? 0 : -EINVAL;
+}
