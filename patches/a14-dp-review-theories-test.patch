+/*
+ * Call only after runtime resume, PHY initialization and AUX enablement.
+ * Use probe(), not readb(): readb() can prepend an access to 0x102.
+ * This follows the LTTPR-before-DPRX ordering in i915. A failed probe is
+ * logged, but does not prevent the existing receiver detection path.
+ */
+static void msm_dp_a14_first_aux_probe(struct msm_dp_display_private *dp,
+				     const char *phase)
+{
+	struct device *dev = &dp->msm_dp_display.pdev->dev;
+	int ret;
+
+	if (!a14_dp_first_aux_probe_test || dp->msm_dp_display.is_edp ||
+	    dp->msm_dp_display.power_on ||
+	    !of_machine_is_compatible("asus,zenbook-a14-ux3407na") ||
+	    !of_device_is_compatible(dev->of_node, "qcom,glymur-dp") ||
+	    strcmp(dev_name(dev), "af54000.displayport-controller"))
+		return;
+
+	ret = drm_dp_dpcd_probe(dp->aux,
+			DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV);
+	dev_info(dev, "A14-first-AUX: phase=%s probe=0xf0000 ret=%d core=%u phy=%u\n",
+		 phase, ret, dp->core_initialized, dp->phy_initialized);
+}
