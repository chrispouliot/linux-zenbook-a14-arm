 		pmic_glink_altmode_request(altmode, ALTMODE_PAN_ACK,
 					    alt_port->index);
 		return;
 	}
+
+	if (alt_port->index == 1 &&
+	    alt_port->svid == USB_TYPEC_DP_SID &&
