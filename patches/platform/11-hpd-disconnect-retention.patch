+static void pmic_glink_altmode_worker(struct work_struct *work)
+{
+	struct pmic_glink_altmode_port *port = work_to_altmode_port(work);
+	struct pmic_glink_altmode_event event;
+	unsigned int budget;
+
+	/* Bound each invocation even if notifications arrive continuously. */
+	for (budget = 0; budget < 8; budget++) {
+		if (!pmic_glink_altmode_take_event(port, &event))
+			return;
+
+		port->orientation = event.orientation;
+		port->svid = event.svid;
+		port->tbt_data = event.tbt_data;
+		port->mode = event.mode;
+		port->hpd_state = event.hpd_state;
+		port->hpd_irq = event.hpd_irq;
+		port->mux_ctrl = event.mux_ctrl;
+
+		if (event.svid == USB_TYPEC_DP_SID && !event.hpd_state)
+			dev_info(port->altmode->dev,
+				 "A14-DP: dispatching retained HPD-low port=%u\n",
+				 port->index);
+
+		/* The existing mux, retimer, DRM notification and ACK path. */
+		pmic_glink_altmode_handle_event(port);
+	}
+
+	/* Same workqueue preserves per-port worker serialization. */
+	queue_work(system_freezable_wq, &port->work);
+}
