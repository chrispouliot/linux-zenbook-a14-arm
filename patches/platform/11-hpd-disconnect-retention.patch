+/* Caller holds status_lock, serializing live and cached notifications. */
+static void drm_aux_hpd_bridge_notify_retained(struct drm_aux_hpd_bridge_data *data,
+					     enum drm_connector_status status)
+{
+	if (data->disconnect_pending && status != connector_status_disconnected) {
+		dev_info(data->dev, "A14-DP: replaying retained AUX HPD disconnect\n");
