+		 * ASUS UX3407NA diagnostic:
+		 * only the left WSA SoundWire bus is present in the
+		 * sound-card DAI link, so constrain this backend to stereo.
+		 */
+		channels->min = channels->max = 2;
+		break;
+
 	case TX_CODEC_DMA_TX_0:
 	case TX_CODEC_DMA_TX_1:
