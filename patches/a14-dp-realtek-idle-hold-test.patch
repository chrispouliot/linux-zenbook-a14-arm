A14: opt-in Realtek DSC post-idle diagnostic hold

Keep the existing shutdown order. For a connected, successfully idled A14
port-one two-lane HBR3 DSC stream, identify the Realtek Dp1.4 branch and pause
before bridge atomic_disable returns. The DPU disable and later sink/source
DSC/FEC and power teardown follow the bounded hold. This distinguishes visible
artifacts near stream idle from later cleanup; it is not a confirmed fix.

Zero (the default) bypasses the test without additional AUX operations. The
root-writable delay is sampled once and capped at one second. Other shutdown
experiments must be disabled. The direct-two-lane patch is independent.

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -28,6 +28,12 @@
 #include "dp_link.h"
 #include "dp_tu_calc.h"
 #include <drm/drm_fixed.h>
+
+/* Diagnostic delay after source idle, before DPU/DSC/FEC teardown. */
+static unsigned int a14_dp_realtek_idle_hold_ms;
+module_param(a14_dp_realtek_idle_hold_ms, uint, 0644);
+MODULE_PARM_DESC(a14_dp_realtek_idle_hold_ms,
+	"Hold Realtek A14 DSC links after PUSH_IDLE; milliseconds, capped at 1000, 0 disables");
 
 static bool a14_dp_early_d3_test;
 module_param(a14_dp_early_d3_test, bool, 0444);
@@ -836,6 +842,59 @@
 	drm_dbg_dp(ctrl->drm_dev, "mainlink off\n");
 }
 
+/* Only connected bridge disable calls this, before the DPU is disabled. */
+void msm_dp_ctrl_a14_realtek_idle_hold(struct msm_dp_ctrl *msm_dp_ctrl)
+{
+	static const u8 realtek_id[] = {
+		0x00, 0xe0, 0x4c, 'D', 'p', '1', '.', '4', 0x00
+	};
+	struct msm_dp_ctrl_private *ctrl = container_of(msm_dp_ctrl,
+		struct msm_dp_ctrl_private, msm_dp_ctrl);
+	unsigned int hold_ms = READ_ONCE(a14_dp_realtek_idle_hold_ms);
+	u8 identity[sizeof(realtek_id)];
+	int ret;
+
+	if (!hold_ms || !msm_dp_ctrl_a14_wake_enabled(msm_dp_ctrl) ||
+	    !ctrl->a14_idle_completed || !ctrl->dsc_configured ||
+	    !ctrl->core_clks_on || !ctrl->stream_clks_on ||
+	    !ctrl->link_clks_on || ctrl->a14_early_d3_status ||
+	    !drm_dp_is_branch(ctrl->panel->dpcd) ||
+	    ctrl->link->link_params.rate != 810000 ||
+	    ctrl->link->link_params.num_lanes != 2 ||
+	    (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN) ||
+	    !msm_dp_aux_is_link_connected(ctrl->aux))
+		return;
+
+	if (a14_dp_defer_sink_clear_test || a14_dp_d3_before_dsc_test ||
+	    a14_dp_early_d3_test) {
+		dev_warn(ctrl->dev,
+			 "A14-Realtek-idle: disable the three shutdown experiments first; no hold\n");
+		return;
+	}
+
+	ret = drm_dp_dpcd_read(ctrl->aux, DP_BRANCH_OUI, identity,
+			     sizeof(identity));
+	if (ret != (int)sizeof(identity)) {
+		dev_warn(ctrl->dev,
+			 "A14-Realtek-idle: branch identity read returned %d; no hold\n",
+			 ret);
+		return;
+	}
+	if (memcmp(identity, realtek_id, sizeof(realtek_id))) {
+		dev_info(ctrl->dev,
+			 "A14-Realtek-idle: branch identity does not match; no hold\n");
+		return;
+	}
+
+	hold_ms = min(hold_ms, 1000U);
+	dev_info(ctrl->dev,
+		 "A14-Realtek-idle: BEGIN %u ms hold after PUSH_IDLE; DPU/DSC/FEC teardown has not started\n",
+		 hold_ms);
+	msleep(hold_ms);
+	dev_info(ctrl->dev,
+		 "A14-Realtek-idle: END hold; normal DPU/DSC/FEC/power shutdown follows\n");
+}
+
 static void msm_dp_ctrl_config_ctrl(struct msm_dp_ctrl_private *ctrl)
 {
 	u32 config = 0, tbd;
diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.h b/drivers/gpu/drm/msm/dp/dp_ctrl.h
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.h
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.h
@@ -27,6 +27,7 @@
 void msm_dp_ctrl_off_link_stream(struct msm_dp_ctrl *msm_dp_ctrl);
 void msm_dp_ctrl_off(struct msm_dp_ctrl *msm_dp_ctrl);
 void msm_dp_ctrl_push_idle(struct msm_dp_ctrl *msm_dp_ctrl);
+void msm_dp_ctrl_a14_realtek_idle_hold(struct msm_dp_ctrl *msm_dp_ctrl);
 irqreturn_t msm_dp_ctrl_isr(struct msm_dp_ctrl *msm_dp_ctrl);
 void msm_dp_ctrl_handle_sink_request(struct msm_dp_ctrl *msm_dp_ctrl);
 struct msm_dp_ctrl *msm_dp_ctrl_get(struct device *dev,
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1756,6 +1756,9 @@
 		msm_dp_ctrl_a14_pre_idle_powerdown(msm_dp_display->ctrl);
 
 	msm_dp_ctrl_push_idle(msm_dp_display->ctrl);
+
+	if (READ_ONCE(msm_dp_display->plugged))
+		msm_dp_ctrl_a14_realtek_idle_hold(msm_dp_display->ctrl);
 }
 
