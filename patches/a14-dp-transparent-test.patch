+/* This opt-in experiment never selects the internal panel or port two. */
+bool msm_dp_ctrl_a14_transparent_enabled(struct msm_dp_ctrl *msm_dp_ctrl)
+{
+	return a14_dp_transparent_test && msm_dp_ctrl_a14_wake_enabled(msm_dp_ctrl);
+}
+
+/*
+ * Caller holds a powered AUX path. Only an inactive transmitter may change
+ * mode: a transparent transition resets repeater training state. Preserve
+ * the physical topology/rate/lane caps rather than erasing them to skip LT.
+ */
+static int msm_dp_ctrl_a14_set_transparent(struct msm_dp_ctrl_private *ctrl,
+					 const char *phase)
+{
+	const unsigned int mode_index = DP_PHY_REPEATER_MODE -
+		DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV;
+	u8 caps[DP_LTTPR_COMMON_CAP_SIZE];
+	u8 mode;
+	int ret;
+
+	if (ctrl->stream_clks_on)
+		return -EBUSY;
+	if (!ctrl->core_clks_on)
+		return -EIO;
+	/* No link MMIO access with link clocks off. */
+	if (ctrl->link_clks_on &&
+	    (msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL) & DP_MAINLINK_CTRL_ENABLE))
+		return -EBUSY;
+
+	ret = drm_dp_dpcd_read(ctrl->aux,
+		DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV, caps, sizeof(caps));
+	if (ret != sizeof(caps))
+		return ret < 0 ? ret : -EIO;
+	mode = caps[mode_index];
+	if (caps[0] < 0x14 || caps[0] == 0xff || drm_dp_lttpr_count(caps) != 2 ||
+	    drm_dp_lttpr_max_lane_count(caps) != 2 ||
+	    (mode != DP_PHY_REPEATER_MODE_TRANSPARENT &&
+	     mode != DP_PHY_REPEATER_MODE_NON_TRANSPARENT))
+		return -EINVAL;
+
+	/* Do not use a cached mode/clock calculation for a different chain. */
+	caps[mode_index] = ctrl->link->lttpr_common_caps[mode_index];
+	if (memcmp(caps, ctrl->link->lttpr_common_caps, sizeof(caps)))
+		return -ESTALE;
+
+	if (mode != DP_PHY_REPEATER_MODE_TRANSPARENT) {
+		ret = msm_dp_ctrl_a14_write_verify(ctrl, DP_PHY_REPEATER_MODE,
+						DP_PHY_REPEATER_MODE_TRANSPARENT);
+		if (ret)
+			return ret;
+	}
+	/* Verify even when the initial common-cap read already reported 55. */
+	ret = drm_dp_dpcd_readb(ctrl->aux, DP_PHY_REPEATER_MODE, &mode);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	if (mode != DP_PHY_REPEATER_MODE_TRANSPARENT)
+		return -EIO;
+
+	ctrl->link->lttpr_common_caps[mode_index] = mode;
+	dev_info(ctrl->dev,
+		 "A14-transparent: phase=%s verified mode=55 physical_repeaters=2 max_rate=%d max_lanes=2\n",
+		 phase, drm_dp_lttpr_max_link_rate(ctrl->link->lttpr_common_caps));
+	return 0;
+}
+
+/* Returns 1 only after verified selection, 0 outside the experiment scope. */
+int msm_dp_ctrl_a14_init_transparent(struct msm_dp_ctrl *msm_dp_ctrl)
+{
+	struct msm_dp_ctrl_private *ctrl = container_of(msm_dp_ctrl,
+		struct msm_dp_ctrl_private, msm_dp_ctrl);
+	int ret;
+
+	if (!msm_dp_ctrl_a14_transparent_enabled(msm_dp_ctrl) ||
+	    (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN) ||
+	    ctrl->panel->video_test ||
+	    drm_dp_lttpr_count(ctrl->link->lttpr_common_caps) != 2 ||
+	    drm_dp_lttpr_max_lane_count(ctrl->link->lttpr_common_caps) != 2)
+		return 0;
+
+	ret = msm_dp_ctrl_a14_set_transparent(ctrl, "hpd");
+	if (ret) {
+		dev_warn(ctrl->dev, "A14-transparent: selection failed=%d; no fallback to aa\n", ret);
+		return ret;
+	}
+	ctrl->link->a14_transparent = true;
+	return 1;
+}
+
+/* Revalidate retained state before an inactive full enable, never in a retry. */
+static int msm_dp_ctrl_a14_prepare_transparent(struct msm_dp_ctrl_private *ctrl)
+{
+	u8 dpcd[DP_RECEIVER_CAP_SIZE];
+	int ret;
+
+	if (!ctrl->link->a14_transparent)
+		return 0;
+	if (!msm_dp_ctrl_a14_transparent_enabled(&ctrl->msm_dp_ctrl) ||
+	    ctrl->link->lttpr_count || ctrl->panel->video_test ||
+	    (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN))
+		return -EINVAL;
+	/* Active retraining only verifies mode below; it must not reset the chain. */
+	if (ctrl->stream_clks_on)
+		return 0;
+
+	ret = msm_dp_ctrl_a14_set_transparent(ctrl, "enable");
+	if (ret)
+		return ret;
+
+	/*
+	 * Initial HPD reads all sink caps after mode selection. On retained-state
+	 * enables, require the same DPRX caps: do not silently alter an already
+	 * checked mode's bandwidth/format/clock requirements during enable.
+	 */
+	ret = drm_dp_read_dpcd_caps(ctrl->aux, dpcd);
+	if (ret)
+		return ret;
+	if (memcmp(dpcd, ctrl->panel->dpcd, sizeof(dpcd))) {
+		dev_warn(ctrl->dev, "A14-transparent: DPRX caps changed; fresh detection required\n");
+		return -ESTALE;
+	}
+	dev_info(ctrl->dev, "A14-transparent: DPRX caps unchanged; train_count=0 rate=%u lanes=%u\n",
+		 ctrl->link->link_params.rate, ctrl->link->link_params.num_lanes);
+	return 0;
+}
+
+/* Called before every training entry, including active-link maintenance. */
+static int msm_dp_ctrl_a14_check_transparent(struct msm_dp_ctrl_private *ctrl)
+{
+	u8 mode;
+	int ret;
+
+	if (ctrl->link->lttpr_count || ctrl->panel->video_test ||
+	    (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN))
+		return -EINVAL;
+	ret = drm_dp_dpcd_readb(ctrl->aux, DP_PHY_REPEATER_MODE, &mode);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	if (mode != DP_PHY_REPEATER_MODE_TRANSPARENT)
+		return -EIO;
+	dev_info(ctrl->dev, "A14-transparent: training verified mode=55; DPRX only\n");
+	return 0;
+}
