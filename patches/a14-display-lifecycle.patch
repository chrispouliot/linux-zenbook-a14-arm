+/* Matching DPCD values only satisfy configuration, never link training. */
+static bool msm_dp_ctrl_a14_config_matches(struct msm_dp_ctrl_private *ctrl,
+					 const u8 config[2])
+{
+	u8 actual[2];
+	int ret;
+
+	if (!a14_dp_config_reuse_test || !msm_dp_ctrl_a14_pair_config_enabled(ctrl))
+		return false;
+
+	/* Fresh normal DPCD access: do not use cached or diagnostic data. */
+	ret = drm_dp_dpcd_read(ctrl->aux, DP_LINK_BW_SET, actual, sizeof(actual));
+	if (ret != sizeof(actual)) {
+		dev_info(ctrl->dev,
+			 "A14-DP-reuse: pre-read returned=%d; using checked write path\n",
+			 ret);
+		return false;
+	}
+
+	if (actual[0] != config[0] || actual[1] != config[1]) {
+		dev_info(ctrl->dev,
+			 "A14-DP-reuse: mismatch got=%02x/%02x expected=%02x/%02x; using checked write path\n",
+			 actual[0], actual[1], config[0], config[1]);
+		return false;
+	}
+
+	dev_info(ctrl->dev,
+		 "A14-DP-reuse: fresh match rate=%02x lanes=%02x; skipping rate/lane write, training still required\n",
+		 actual[0], actual[1]);
+	return true;
+}
