+static bool msm_dp_ctrl_a14_edp_link_fits(struct msm_dp_ctrl_private *ctrl)
+{
+	/* Full mode clock: wide-bus halves the interface clock, not payload. */
+	u64 required = (u64)ctrl->panel->msm_dp_mode.drm_mode.clock *
+		ctrl->panel->msm_dp_mode.bpp;
