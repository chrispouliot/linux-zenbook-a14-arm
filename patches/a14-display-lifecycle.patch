+static int msm_dp_ctrl_a14_pair_configure(struct msm_dp_ctrl_private *ctrl,
+					struct msm_dp_link_info *link)
+{
+	u8 config[] = { drm_dp_link_rate_to_bw_code(link->rate),
+		       link->num_lanes | DP_LANE_COUNT_ENHANCED_FRAME_EN };
+	u8 actual[2];
+	int attempt, ret;
+
+	/* The existing dock test uses LINK_BW_SET, never an eDP rate table. */
+	if (link->use_rate_set)
