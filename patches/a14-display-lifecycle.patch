+static void msm_dp_ctrl_a14_trace_state(struct msm_dp_ctrl_private *ctrl,
+				      const char *phase, int attempt, int result)
+{
+	static const struct {
+		unsigned int address;
+		u8 size;
+	} ranges[] = {
+		{ DP_SET_POWER, 1 },
+		{ DP_DPCD_REV, DP_RECEIVER_CAP_SIZE },
+		{ DP_LINK_BW_SET, 3 },
+		{ DP_FEC_CONFIGURATION, 1 },
+		{ DP_DSC_ENABLE, 1 },
+		{ DP_LANE0_1_STATUS, DP_LINK_STATUS_SIZE },
+		{ DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV,
+		  DP_LTTPR_COMMON_CAP_SIZE },
+	};
+	u8 data[DP_AUX_MAX_PAYLOAD_BYTES], reply;
+	u32 seq;
+	int i, ret;
+
+	if (!a14_dp_state_trace_test || !msm_dp_ctrl_a14_pair_config_enabled(ctrl))
+		return;
+
+	seq = ++ctrl->a14_state_trace_sequence;
+	dev_info(ctrl->dev,
+		 "A14-DP-state: seq=%u phase=%s attempt=%d result=%d rate=%u lanes=%u core=%u link=%u stream=%u cached_repeaters=%d cached_caps=%*ph\n",
+		 seq, phase, attempt, result, ctrl->link->link_params.rate,
+		 ctrl->link->link_params.num_lanes, ctrl->core_clks_on,
+		 ctrl->link_clks_on, ctrl->stream_clks_on, ctrl->link->lttpr_count,
+		 DP_LTTPR_COMMON_CAP_SIZE, ctrl->link->lttpr_common_caps);
+
+	for (i = 0; i < ARRAY_SIZE(ranges); i++) {
+		ret = msm_dp_ctrl_a14_trace_read(ctrl->aux, ranges[i].address,
+					       data, ranges[i].size, &reply);
+		if (ret == ranges[i].size)
+			dev_info(ctrl->dev,
+				 "A14-DP-state: seq=%u addr=%#x size=%u ret=%d reply=%02x data=%*ph\n",
+				 seq, ranges[i].address, ranges[i].size, ret, reply,
+				 ret, data);
+		else
+			dev_info(ctrl->dev,
+				 "A14-DP-state: seq=%u addr=%#x size=%u ret=%d reply=%02x\n",
+				 seq, ranges[i].address, ranges[i].size, ret, reply);
+		/* No further probing after a reported detach/power-down. */
+		if (ret == -ENXIO || ret == -ENODEV || ret == -EBUSY)
+			break;
+	}
+	dev_info(ctrl->dev, "A14-DP-state: seq=%u end\n", seq);
+}
