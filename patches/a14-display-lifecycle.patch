+/* One native transfer, no implicit probe or helper retry loop. */
+static int msm_dp_ctrl_a14_single_xfer(struct drm_dp_aux *aux, unsigned int address,
+				     u8 request, u8 *buffer, size_t size, u8 *reply)
+{
+	struct drm_dp_aux_msg msg = {
+		.address = address,
+		.request = request,
+		.reply = 0xff,
+		.buffer = buffer,
+		.size = size,
+	};
+	int ret;
+
+	*reply = 0xff;
+	if (!size || size > DP_AUX_MAX_PAYLOAD_BYTES || !buffer ||
+	    (request != DP_AUX_NATIVE_READ && request != DP_AUX_NATIVE_WRITE))
+		return -EINVAL;
+	if (aux->is_remote)
+		return -EOPNOTSUPP;
+
+	/* Same serialization and powered-down guard as native DPCD access. */
+	mutex_lock(&aux->hw_mutex);
+	if (aux->powered_down) {
+		ret = -EBUSY;
+		goto out;
+	}
+	/* The normal driver callback retains AUX init/HPD/PM checks. */
+	ret = aux->transfer(aux, &msg);
+	*reply = msg.reply;
+	if (ret >= 0) {
+		switch (msg.reply & DP_AUX_NATIVE_REPLY_MASK) {
+		case DP_AUX_NATIVE_REPLY_ACK:
+			if (ret != size)
+				ret = -EPROTO;
+			break;
+		case DP_AUX_NATIVE_REPLY_DEFER:
+			ret = -EAGAIN;
+			break;
+		default:
+			ret = -EIO;
+			break;
+		}
+	}
+ out:
+	mutex_unlock(&aux->hw_mutex);
+	return ret;
+}
+
+static int msm_dp_ctrl_a14_trace_read(struct drm_dp_aux *aux, unsigned int address,
+				    u8 *buffer, size_t size, u8 *reply)
+{
+	return msm_dp_ctrl_a14_single_xfer(aux, address, DP_AUX_NATIVE_READ,
+					 buffer, size, reply);
+}
