+static bool msm_dp_ctrl_a14_pair_config_enabled(struct msm_dp_ctrl_private *ctrl)
+{
+	return a14_dp_pair_config_test &&
+		msm_dp_ctrl_a14_wake_enabled(&ctrl->msm_dp_ctrl);
+}
+
+static int msm_dp_ctrl_a14_pair_configure(struct msm_dp_ctrl_private *ctrl,
+					struct msm_dp_link_info *link)
+{
+	u8 config[] = { drm_dp_link_rate_to_bw_code(link->rate),
+		       link->num_lanes | DP_LANE_COUNT_ENHANCED_FRAME_EN };
+	u8 actual[2];
+	int attempt, ret;
+
+	/* The existing dock test uses LINK_BW_SET, never an eDP rate table. */
+	if (link->use_rate_set)
+		return -EINVAL;
+
+	for (attempt = 1; attempt <= 2; attempt++) {
+		/*
+		 * Match the i915 LINK_BW_SET programming form: rate and lanes
+		 * in one native AUX request, instead of a lane-first write.
+		 * Keep the normal AUX locking, retries and disconnect checks.
+		 */
+		ret = drm_dp_dpcd_write(ctrl->aux, DP_LINK_BW_SET,
+					config, sizeof(config));
+		if (ret != sizeof(config)) {
+			dev_warn(ctrl->dev,
+				 "A14-DP-pair: attempt=%d write returned=%d expected=2\n",
+				 attempt, ret);
+		} else {
+			ret = drm_dp_dpcd_read(ctrl->aux, DP_LINK_BW_SET,
+					       actual, sizeof(actual));
+			if (ret == sizeof(actual)) {
+				if (actual[0] == config[0] && actual[1] == config[1]) {
+					dev_info(ctrl->dev,
+						 "A14-DP-pair: verified rate=%02x lanes=%02x attempt=%d\n",
+						 config[0], config[1], attempt);
+					return 0;
+				}
+				dev_warn(ctrl->dev,
+					 "A14-DP-pair: attempt=%d mismatch got=%02x/%02x expected=%02x/%02x\n",
+					 attempt, actual[0], actual[1], config[0], config[1]);
+			} else {
+				dev_warn(ctrl->dev,
+					 "A14-DP-pair: attempt=%d read returned=%d expected=2\n",
+					 attempt, ret);
+			}
+		}
+		if (ret >= 0)
+			ret = -EIO;
+		/* A real disconnect is not a reason to issue another request. */
+		if (attempt == 2 || ret == -ENXIO || ret == -ENODEV)
+			return ret;
+		msleep(20);
+	}
+
+	return -EIO;
+}
