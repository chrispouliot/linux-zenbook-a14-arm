+/* Resume can retain the repeater count while hardware reverts to transparent. */
+static int msm_dp_ctrl_a14_restore_repeater_mode(struct msm_dp_ctrl_private *ctrl)
+{
+	const unsigned int mode_index = DP_PHY_REPEATER_MODE -
+		DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV;
+	u8 caps[DP_LTTPR_COMMON_CAP_SIZE], mode;
+	int count, ret;
+
+	if (!a14_dp_repeater_restore_test ||
+	    !msm_dp_ctrl_a14_wake_enabled(&ctrl->msm_dp_ctrl) ||
+	    !ctrl->link->lttpr_count)
+		return 0;
+
+	if (ctrl->link->lttpr_count < 0 ||
+	    ctrl->link->lttpr_count > DP_MAX_LTTPR_COUNT)
+		return -EINVAL;
+
+	/* Read live state; do not infer the mode from the cached caps. */
+	ret = drm_dp_dpcd_read(ctrl->aux,
+		DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV,
+		caps, sizeof(caps));
+	if (ret != sizeof(caps)) {
+		dev_warn(ctrl->dev, "A14-DP-repeater: caps read returned=%d\n", ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	count = drm_dp_lttpr_count(caps);
+	mode = caps[mode_index];
+	dev_info(ctrl->dev,
+		 "A14-DP-repeater: live_count=%d cached_count=%d mode=%02x caps=%*ph\n",
+		 count, ctrl->link->lttpr_count, mode, (int)sizeof(caps), caps);
+	if (caps[0] < 0x14 || caps[0] == 0xff || count != ctrl->link->lttpr_count)
+		return -EINVAL;
+
+	if (mode == DP_PHY_REPEATER_MODE_NON_TRANSPARENT)
+		return 0;
+	if (mode != DP_PHY_REPEATER_MODE_TRANSPARENT)
+		return -EINVAL;
+
+	/* Already transparent: restore only the missing non-transparent step. */
+	ret = drm_dp_dpcd_writeb(ctrl->aux, DP_PHY_REPEATER_MODE,
+		DP_PHY_REPEATER_MODE_NON_TRANSPARENT);
+	if (ret != 1) {
+		dev_warn(ctrl->dev, "A14-DP-repeater: restore write returned=%d\n", ret);
+		return ret < 0 ? ret : -EIO;
+	}
+
+	ret = drm_dp_dpcd_readb(ctrl->aux, DP_PHY_REPEATER_MODE, &mode);
+	if (ret != 1) {
+		dev_warn(ctrl->dev, "A14-DP-repeater: verify read returned=%d\n", ret);
+		return ret < 0 ? ret : -EIO;
+	}
+	if (mode != DP_PHY_REPEATER_MODE_NON_TRANSPARENT) {
+		dev_warn(ctrl->dev, "A14-DP-repeater: verify mode=%02x expected=aa\n", mode);
+		return -EIO;
+	}
+
+	/* Do not change topology, rate/lane selection, or bypass link training. */
+	ctrl->link->lttpr_common_caps[mode_index] = mode;
+	dev_info(ctrl->dev,
+		 "A14-DP-repeater: restored 55->aa and verified; normal training follows\n");
+	return 0;
+}
+
