+/*
+ * One reset sequence per full on_link(), before main-link enable and FEC
+ * setup, not in link_train(): on_stream() can train again with clocks on.
+ * The direct one-repeater path and active-link maintenance are excluded.
+ */
+static int msm_dp_ctrl_a14_reset_repeater_chain(struct msm_dp_ctrl_private *ctrl)
+{
+	const unsigned int mode_index = DP_PHY_REPEATER_MODE -
+		DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV;
+	u8 caps[DP_LTTPR_COMMON_CAP_SIZE], initial;
+	int count, ret;
+	u32 mainlink;
+
+	if (!a14_dp_repeater_reset_test ||
+	    !msm_dp_ctrl_a14_wake_enabled(&ctrl->msm_dp_ctrl) ||
+	    (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN) ||
+	    ctrl->link->lttpr_count != 2 ||
+	    ctrl->link->link_params.num_lanes != 2)
+		return 0;
+
+	if (ctrl->stream_clks_on) {
+		dev_info(ctrl->dev, "A14-repeater-reset: skipped; stream clocks on\n");
+		return 0;
+	}
+	if (!ctrl->core_clks_on || !ctrl->link_clks_on)
+		return -EIO;
+
+	mainlink = msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL);
+	if (mainlink & DP_MAINLINK_CTRL_ENABLE) {
+		dev_info(ctrl->dev,
+			 "A14-repeater-reset: skipped; transmitter enabled ctrl=%#x\n", mainlink);
+		return 0;
+	}
+
+	ret = drm_dp_dpcd_read(ctrl->aux,
+		DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV,
+		caps, sizeof(caps));
+	if (ret != sizeof(caps))
+		return ret < 0 ? ret : -EIO;
+	count = drm_dp_lttpr_count(caps);
+	initial = caps[mode_index];
+	if (caps[0] < 0x14 || caps[0] == 0xff || count != 2 ||
+	    (initial != DP_PHY_REPEATER_MODE_TRANSPARENT &&
+	     initial != DP_PHY_REPEATER_MODE_NON_TRANSPARENT))
+		return -EINVAL;
+
+	dev_info(ctrl->dev,
+		 "A14-repeater-reset: begin mode=%02x count=%d mainlink=%#x stream=0\n",
+		 initial, count, mainlink);
+	/* Establish aa first if the chain reverted to 55 during standby. */
+	if (initial == DP_PHY_REPEATER_MODE_TRANSPARENT) {
+		ret = msm_dp_ctrl_a14_write_verify(ctrl, DP_PHY_REPEATER_MODE,
+				DP_PHY_REPEATER_MODE_NON_TRANSPARENT);
+		dev_info(ctrl->dev, "A14-repeater-reset: establish aa ret=%d\n", ret);
+		if (ret)
+			return ret;
+	}
+
+	/* DP 2.0 3.6.7: the non-transparent -> transparent edge resets state. */
+	ret = msm_dp_ctrl_a14_write_verify(ctrl, DP_PHY_REPEATER_MODE,
+			DP_PHY_REPEATER_MODE_TRANSPARENT);
+	dev_info(ctrl->dev, "A14-repeater-reset: aa->55 ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	ret = msm_dp_ctrl_a14_write_verify(ctrl, DP_PHY_REPEATER_MODE,
+			DP_PHY_REPEATER_MODE_NON_TRANSPARENT);
+	dev_info(ctrl->dev, "A14-repeater-reset: 55->aa ret=%d\n", ret);
+	if (ret)
+		return ret;
+
+	/* Require the same detected chain before normal per-repeater training. */
+	ret = drm_dp_dpcd_read(ctrl->aux,
+		DP_LT_TUNABLE_PHY_REPEATER_FIELD_DATA_STRUCTURE_REV,
+		caps, sizeof(caps));
+	if (ret != sizeof(caps))
+		return ret < 0 ? ret : -EIO;
+	if (caps[0] < 0x14 || caps[0] == 0xff || drm_dp_lttpr_count(caps) != count ||
+	    caps[mode_index] != DP_PHY_REPEATER_MODE_NON_TRANSPARENT)
+		return -EINVAL;
+
+	ctrl->link->lttpr_common_caps[mode_index] = caps[mode_index];
+	dev_info(ctrl->dev, "A14-repeater-reset: verified reset; normal sink setup/training follows\n");
+	return 0;
+}
