+static int msm_dp_ctrl_sink_fec_enable(struct msm_dp_ctrl_private *ctrl)
+{
+	int ret = drm_dp_dpcd_writeb(ctrl->aux, DP_FEC_CONFIGURATION, DP_FEC_READY);
+
+	if (ret == 1)
+		return 0;
+	dev_err(ctrl->dev, "A14-DSC-test: sink FEC ready failed: %d\n", ret);
+	return ret < 0 ? ret : -EIO;
+}
+
+static int msm_dp_ctrl_host_fec_start(struct msm_dp_ctrl_private *ctrl)
+{
+	u8 status;
+	int i, ret;
+
+	for (i = 0; i < 3; i++) {
+		msm_dp_ctrl_fec_config(ctrl, true);
+		usleep_range(900, 1000);
+		ret = drm_dp_dpcd_readb(ctrl->aux, DP_FEC_STATUS, &status);
+		if (ret != 1)
+			return ret < 0 ? ret : -EIO;
+		if (status & DP_FEC_DECODE_EN_DETECTED) {
+			dev_info(ctrl->dev, "A14-DSC-test: FEC decode detected status=%02x\n", status);
+			return 0;
+		}
+	}
+	dev_err(ctrl->dev, "A14-DSC-test: FEC decode timeout\n");
+	return -ETIMEDOUT;
+}
+
+static int msm_dp_ctrl_sink_dsc_enable(struct msm_dp_ctrl_private *ctrl)
+{
+	u8 value;
+	int ret;
+
+	ret = drm_dp_dpcd_writeb(ctrl->aux, DP_DSC_ENABLE, DP_DECOMPRESSION_EN);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	ret = drm_dp_dpcd_readb(ctrl->aux, DP_DSC_ENABLE, &value);
+	if (ret != 1)
+		return ret < 0 ? ret : -EIO;
+	if (!(value & DP_DECOMPRESSION_EN))
+		return -EIO;
+	dev_info(ctrl->dev, "A14-DSC-test: sink DSC_ENABLE=%02x\n", value);
+	return 0;
+}
+
+static void msm_dp_ctrl_dsc_stop(struct msm_dp_ctrl_private *ctrl)
+{
+	if (!ctrl->dsc_configured)
+		return;
+	if (msm_dp_aux_is_link_connected(ctrl->aux)) {
+		drm_dp_dpcd_writeb(ctrl->aux, DP_DSC_ENABLE, 0);
+		drm_dp_dpcd_writeb(ctrl->aux, DP_FEC_CONFIGURATION, 0);
+	}
+	msm_dp_ctrl_fec_config(ctrl, false);
+	msm_dp_panel_dsc_config(ctrl->panel, &ctrl->dsc_data, false);
+	msm_dp_ctrl_config_dsc_dto(ctrl);
+	msm_dp_panel_override_ack_dto(ctrl->panel, false);
+	ctrl->dsc_configured = false;
+}
